{
  "name": "@navanem/payload-contact",
  "version": "0.2.0",
  "description": "Contact form plugin for Payload 3.x: a message inbox collection, runtime settings, spam protection (honeypot + rate limit), an admin inbox view, and a ready-to-use form component.",
  "license": "MIT",
  "author": "navanem <tools@sunitech.ch>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    },
    "./types": {
      "types": "./dist/exports/types.d.ts",
      "default": "./dist/exports/types.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "clean": "rimraf dist",
    "dev": "payload dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "contact",
    "contact-form",
    "inbox",
    "form"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navanem/navanem_payload_contact.git"
  },
  "homepage": "https://github.com/navanem/navanem_payload_contact#readme",
  "bugs": {
    "url": "https://github.com/navanem/navanem_payload_contact/issues"
  },
  "dependencies": {
    "nodemailer": "^9.0.1"
  },
  "peerDependencies": {
    "payload": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@payloadcms/db-sqlite": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "payload": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.20.0"
  }
}
